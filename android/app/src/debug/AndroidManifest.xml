<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the check on the emulator (build/android-check.js) hands the app a plain folder with the test
     library; reading it needs "all files access", granted there with `appops set`. Release builds carry none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
</manifest>
